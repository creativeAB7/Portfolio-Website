# Copy this file to `.env.local` for local development and set values as needed.
# Everything here is optional for the site to run; sensible fallbacks are used.

# Canonical public site URL — used for metadata, canonical links, and (later)
# the sitemap. Set this to your production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics (optional) ---
# Leave blank to keep analytics disabled. When set, the relevant script loads
# automatically (see src/components/analytics.tsx).

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=
